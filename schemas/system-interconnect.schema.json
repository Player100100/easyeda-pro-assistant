{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multi-board system interconnect model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "system", "board_instances", "interconnects"],
  "properties": {
    "schema_version": { "const": 1 },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision", "configuration", "scenarios"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "configuration": { "type": "string", "minLength": 1 },
        "scenarios": {
          "type": "array",
          "items": { "$ref": "#/$defs/scenario" }
        }
      }
    },
    "board_instances": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/boardInstance" }
    },
    "interconnects": {
      "type": "array",
      "items": { "$ref": "#/$defs/interconnect" }
    }
  },
  "$defs": {
    "evidenceStatus": {
      "type": "string",
      "enum": ["confirmed", "inferred", "unknown"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "references"],
      "properties": {
        "status": { "$ref": "#/$defs/evidenceStatus" },
        "references": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Document, drawing, test report, requirement, or other traceable evidence."
        },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "confirmed" } } },
          "then": { "properties": { "references": { "minItems": 1 } } }
        }
      ]
    },
    "boardInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "design_name", "revision", "design_source", "connectors"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "design_name": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "design_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256"],
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
            "easyeda_board_uuid": { "type": "string" },
            "pcb_uuid": { "type": "string" },
            "schematic_uuids": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "bom_revision": { "type": "string" },
            "assembly_variant": { "type": "string" },
            "firmware_configuration": { "type": "string" }
          }
        },
        "connectors": {
          "type": "array",
          "items": { "$ref": "#/$defs/connector" }
        }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "part", "view", "pins", "source"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "part": { "type": "string", "minLength": 1 },
        "view": { "type": "string", "minLength": 1 },
        "pins": {
          "type": "array",
          "items": { "$ref": "#/$defs/connectorPin" }
        },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "connectorPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "function", "source"],
      "properties": {
        "number": { "type": "string", "minLength": 1 },
        "function": { "type": "string", "minLength": 1 },
        "board_net": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board_instance_id", "connector", "pin"],
      "properties": {
        "board_instance_id": { "type": "string", "minLength": 1 },
        "connector": { "type": "string", "minLength": 1 },
        "pin": { "type": "string", "minLength": 1 }
      }
    },
    "interconnect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "part_or_harness", "revision", "topology", "connections", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["cable", "backplane", "direct", "other"] },
        "part_or_harness": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "topology": { "type": "string", "minLength": 1 },
        "connections": {
          "type": "array",
          "items": { "$ref": "#/$defs/connection" }
        },
        "source": { "$ref": "#/$defs/source" },
        "electrical_limits": { "$ref": "#/$defs/electricalLimits" }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wire_id", "signal", "signal_class", "endpoints", "source"],
      "properties": {
        "wire_id": { "type": "string", "minLength": 1 },
        "signal": { "type": "string", "minLength": 1 },
        "signal_class": {
          "enum": ["power", "ground", "analog", "digital", "differential", "shield", "mechanical", "unknown"]
        },
        "endpoints": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/endpoint" }
        },
        "source": { "$ref": "#/$defs/source" },
        "electrical_limits": { "$ref": "#/$defs/electricalLimits" },
        "note": { "type": "string" }
      }
    },
    "electricalLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "voltage_min_v": { "type": "number" },
        "voltage_max_v": { "type": "number" },
        "continuous_current_a": { "type": "number", "minimum": 0 },
        "peak_current_a": { "type": "number", "minimum": 0 },
        "peak_duration_ms": { "type": "number", "minimum": 0 },
        "data_rate_hz": { "type": "number", "minimum": 0 },
        "cable_length_m": { "type": "number", "minimum": 0 },
        "wire_gauge_awg": { "type": "string" },
        "contact_resistance_ohm": { "type": "number", "minimum": 0 },
        "isolation_rating_v": { "type": "number", "minimum": 0 },
        "termination": { "type": "string" },
        "return_path": { "type": "string" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "active_board_instances", "connected_interconnects", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "active_board_instances": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "connected_interconnects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "source": { "$ref": "#/$defs/source" }
      }
    }
  }
}
